  {
    "build": "4.0.1",
    "current": true,
    "dir": "<tmp>/data/sruman/runtimes/steamrt4/4.0.1",
    "linked": false,
    "name": "steamrt4",
    "source": {
      "from": "<tmp>/SteamLinuxRuntime_4",
      "kind": "import"
    }
  }
]
